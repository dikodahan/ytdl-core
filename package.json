{
  "name": "@distube/ytdl-core",
  "description": "YouTube video downloader — yt-dlp-inspired TypeScript core with ytdl-core compatibility layer.",
  "keywords": [
    "youtube",
    "video",
    "download",
    "yt-dlp",
    "ytdl",
    "distube",
    "cloudflare"
  ],
  "version": "5.0.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/distubejs/ytdl-core.git"
  },
  "author": "Skick (https://github.com/skick1234)",
  "contributors": [
    "fent <fentbox@gmail.com> (https://github.com/fent)",
    "Tobias Kutscha (https://github.com/TimeForANinja)",
    "Andrew Kelley (https://github.com/andrewrk)",
    "Mauricio Allende (https://github.com/mallendeo)",
    "Rodrigo Altamirano (https://github.com/raltamirano)",
    "Jim Buck (https://github.com/JimmyBoh)",
    "Pawel Rucinski (https://github.com/Roki100)",
    "Alexander Paolini (https://github.com/Million900o)"
  ],
  "packageManager": "pnpm@10.20.0",
  "main": "./lib/compat/ytdl-core.js",
  "types": "./lib/compat/ytdl-core.d.ts",
  "exports": {
    ".": {
      "types": "./lib/compat/ytdl-core.d.ts",
      "require": "./lib/compat/ytdl-core.js",
      "default": "./lib/compat/ytdl-core.js"
    },
    "./core": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./web": {
      "types": "./lib/web/server.d.ts",
      "require": "./lib/web/server.js",
      "default": "./lib/web/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ytdl-web": "./scripts/ytdl-web.js"
  },
  "files": [
    "lib",
    "web",
    "scripts/ytdl-web.js",
    "scripts/copy-vendor.js",
    "src/extractor/youtube/jsc/vendor",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-vendor.js",
    "typecheck": "tsc --noEmit",
    "generate:extractors": "python3 scripts/generate-remaining-extractors.py",
    "test:extract": "node scripts/smoke-extract.js",
    "test": "node --test test/extractors/suitable.test.js test/extractors/list.test.js test/extractors/kaltura-ott.test.js test/extractors/kaltura-ott-discover.test.js test/extractors/ontivi.test.js",
    "test:live": "YTDL_LIVE_TEST=1 node --test test/extractors/smoke-live.test.js",
    "web": "node scripts/ytdl-web.js",
    "prettier": "prettier --write \"**/*.{js,json,yml,md,ts,css,html}\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "http-cookie-agent": "^8.0.0",
    "m3u8stream": "^0.8.6",
    "tough-cookie": "^6.0.2",
    "undici": "^8.7.0"
  },
  "optionalDependencies": {
    "cycletls": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "license": "MIT",
  "funding": "https://github.com/distubejs/ytdl-core?sponsor"
}
